{
  "compilerOptions": {
    /* Base Options from your Next.js config */
    "esModuleInterop": true,
    "skipLibCheck": true, // Often true in monorepos to speed up type checking across dependencies
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true, // Good for transpilers like Babel/SWC
    "verbatimModuleSyntax": true, // Recommended for modern TypeScript

    /* Strictness - All enabled */
    "strict": true,
    "noUncheckedIndexedAccess": true, // Excellent for catching runtime errors
    // "checkJs": true, // Enable if you have JS files you want type-checked, can be noisy initially

    /* Module System */
    "module": "esnext", // Use ESNext for modern module features
    "moduleResolution": "bundler", // Recommended for modern tooling, aligns with how bundlers resolve modules

    /* Output - Root does not emit */
    "noEmit": true,

    /* JSX - Preserve for frameworks to handle */
    "jsx": "preserve",

    /* Other useful options */
    "forceConsistentCasingInFileNames": true,
    "declaration": false, // Root doesn't generate .d.ts files
    "declarationMap": false, // Root doesn't generate .d.ts.map files
    "sourceMap": false // Root doesn't generate source maps
  },
  "exclude": [
    "node_modules",
    ".turbo",
    "dist", // Common output for packages
    "apps/**/dist", // Specific app outputs
    "apps/**/.next", // Next.js output
    "packages/**/dist" // Specific package outputs
  ]
  // "include" is intentionally omitted or empty at the root,
  // as we don't want the root tsconfig to try and compile any files directly.
  // Each app/package will define its own "include".
}
