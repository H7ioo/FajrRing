{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default Base",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022"],
    "noEmit": true,
    "paths": {
      // @see https://github.com/microsoft/TypeScript/issues/61504
      // @see https://turborepo.com/docs/core-concepts/internal-packages#limitations-and-tradeoffs
      "#*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".turbo"]
}
