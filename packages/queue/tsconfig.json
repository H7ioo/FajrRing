{
  "extends": "@fajr-ring/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "allowJs": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules"]
}
