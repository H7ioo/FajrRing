{
  "extends": "@fajr-ring/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2022",
    "outDir": "dist",
    "composite": true,
    "incremental": true,
    "isolatedModules": true,
    "allowJs": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", ".turbo", "dist"]
}
