{
  "extends": "@fajr-ring/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "nodenext",
    "target": "ES2022",
    "noEmit": true,
    "composite": false,
    "incremental": true,
    "isolatedModules": true,
    "allowJs": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "lib": ["ESNext"]
  },

  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", ".turbo"]
}
