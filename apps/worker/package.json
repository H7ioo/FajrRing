    "@t3-oss/env-core": "^0.13.6",
    "bullmq": "^5.53.2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.11",
    "ioredis": "^5.6.1",
    "ngrok": "5.0.0-beta.2",
    "twilio": "^5.6.1",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@fajr-ring/tsconfig": "workspace:*",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
